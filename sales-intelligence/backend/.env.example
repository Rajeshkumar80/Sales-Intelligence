# Copy to .env and fill in real values. Never commit .env.
# Atlas credentials used to build mongodb+srv:// URI at runtime.
MONGODB_HOST=your-cluster.mongodb.net
MONGODB_USERNAME=your-db-user
MONGODB_PASSWORD=
MONGODB_DB=bda_sales

# Optional: full URI overrides the fields above (keep it in .env only)
# MONGODB_URI=

HIVE_URL=jdbc:hive2://127.0.0.1:10000/default
BATCH_SIZE=5000
SIMULATOR_INTERVAL_SECONDS=5
SIMULATOR_BATCH_SIZE=20
